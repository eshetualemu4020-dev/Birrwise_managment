# ── Database ────────────────────────────────────────────────────────────────
# Use 'sqlite' for zero-config local development, or 'mysql' for production.
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# MySQL settings (only used when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=birwise

# ── Auth ────────────────────────────────────────────────────────────────────
# IMPORTANT: use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ── Email (password reset) ──────────────────────────────────────────────────
# Leave SMTP_HOST blank in development. The app will then create a throwaway
# Ethereal account and print a preview URL to the console after each send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Public URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:5173
